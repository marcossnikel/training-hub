# Required for owner-scoped Strava connection storage. Set a
# base64url-encoded random 32-byte secret in the runtime secret manager; never
# commit or share a value. Missing or malformed values fail closed.
STRAVA_CONNECTION_ENCRYPTION_KEY=

# Database — dev and prod are split, keep them that way.
# LOCAL DEVELOPMENT: leave both empty. The app uses the local file data/app.db.
# Do NOT point these at the production Turso database from your machine: local dev
# must never target prod. Sharing one DB is the risk this split closes.
# PRODUCTION (Vercel) sets its own values:
#   TURSO_DATABASE_URL=libsql://training-hub-<org>.turso.io
#   TURSO_AUTH_TOKEN=<token from: turso db tokens create training-hub>
# The seed/backfill write scripts refuse to run against a remote (non-file:) URL as
# a safety net. Override only when you truly mean to with ALLOW_REMOTE_DB=1.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Shoe photos. Leave empty locally (files go to data/uploads/).
# On Vercel, create a Blob store and this token is injected automatically.
BLOB_READ_WRITE_TOKEN=

# Better Auth database sessions. Generate a unique 32+ character value locally
# (for example: `openssl rand -base64 32`); never commit it. Email delivery and
# password recovery are intentionally not configured in this issue.
BETTER_AUTH_SECRET=
# Optional in local development. Set to the canonical app origin in deployed environments.
BETTER_AUTH_URL=http://localhost:3000

# BYO Strava callback origin. Required in any deployed environment, as an exact
# canonical HTTPS origin with no path/query/hash (for example,
# https://preview.training-hub.example). This value is non-secret. Local loopback
# development derives localhost/127.0.0.1/[::1] directly from the request instead.
TRAINING_HUB_PUBLIC_ORIGIN=

# Invitation-only account creation. Keep disabled unless this environment
# should accept issued private links. Production additionally requires the two
# explicit production approval switches and an exact canonical-origin match.
BETA_INVITE_REGISTRATION_ENABLED=
TRAINING_HUB_PRODUCTION_APPROVED=
TRAINING_HUB_PRODUCTION_INVITES_ENABLED=
TRAINING_HUB_INVITE_PRODUCTION_ORIGIN=
