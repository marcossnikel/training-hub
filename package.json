{
  "name": "training-hub",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "biome lint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "check:env": "node scripts/check-environment-boundary.mjs",
    "check:retired-strava-config": "node scripts/check-retired-strava-config.mjs",
    "db:reset": "node scripts/reset-local-db.mjs --confirm-reset-disposable-data",
    "e2e:seed": "rm -f data/e2e.db data/e2e.db-shm data/e2e.db-wal data/e2e.db-journal && DATABASE_URL=\"${DATABASE_URL:-file:data/e2e.db}\" tsx scripts/seed.ts",
    "deadcode": "knip",
    "cycles": "madge --circular --ts-config tsconfig.json --extensions ts,tsx src",
    "verify:fast": "npm run check:env && npm run check:retired-strava-config && npm run typecheck && npm run lint && npm run format:check && npm run test:unit && npm run deadcode && npm run cycles",
    "verify": "npm run verify:fast && npm run test:e2e",
    "test:e2e:production": "echo 'Production smoke: disposable E2E database and loopback Strava provider; next build; next start' && E2E_PRODUCTION=1 playwright test --project=production-smoke",
    "seed": "tsx scripts/seed.ts",
    "seed:clear": "tsx scripts/seed.ts --clear",
    "backfill:best-efforts": "tsx scripts/backfill-best-efforts.ts",
    "backfill:curve-points": "tsx scripts/backfill-curve-points.ts",
    "backfill:metrics": "tsx scripts/backfill-metrics.ts",
    "fetch:history": "tsx scripts/fetch-history.ts",
    "beta:invite": "tsx scripts/issue-beta-invite.ts"
  },
  "dependencies": {
    "@libsql/client": "^0.17.4",
    "@libsql/kysely-libsql": "0.4.1",
    "@vercel/blob": "^2.6.1",
    "@vercel/speed-insights": "^2.0.0",
    "better-auth": "1.4.18",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "kysely": "0.28.17",
    "lucide-react": "^1.25.0",
    "next": "16.2.10",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "shadcn": "^4.13.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@biomejs/biome": "^2.5.10",
    "jsdom": "^29.1.1",
    "knip": "^6.29.0",
    "madge": "^8.0.0",
    "prettier": "^3.9.6",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
